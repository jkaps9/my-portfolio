---
import { Picture } from "astro:assets";
import { Icon } from "astro-icon/components";

import weatherApplicationImg from "@assets/images/portfolio/weather-application_screenshot.png";
import devHorizonImg from "@assets/images/portfolio/devhorizon_screenshot.png";
import officeLiteImg from "@assets/images/portfolio/officelite_screenshot.png";
import fxCheckerImg from "@assets/images/portfolio/fx-checker_desktop_screenshot.png";
import placeholderImg from "@assets/images/portfolio/placeholder_screenshot.png";

const projects = [
  {
    image: weatherApplicationImg,
    imageAltText: "weather application screenshot",
    title: "Weather Now",
    description:
      "A user-friendly weather application with an intuitive interface that provides essential weather information in a minimilast format.",
    url: "https://weatheryourway.netlify.app/",
  },
  {
    image: devHorizonImg,
    imageAltText: "tech conference website screenshot",
    title: "DevHorizon",
    description: "An informational site for a technology conference.",
    url: "https://devhorizon26.netlify.app/",
  },
  {
    image: fxCheckerImg,
    imageAltText: "fx checker screenshot",
    title: "FX Checker",
    description: "A web application to check currency conversion rates.",
    url: "https://jkaps9.github.io/fx-checker",
  },
];
---

<section
  id="portfolio"
  class="portfolio"
>
  <div class="container">
    <h2>Portfolio</h2>
    <div class="card-container">
      {projects.map((project) => (
        <div class="project__card">
          <div class="project__screenshot">
            {project.image ? (
              <Picture
                src={project.image}
                alt={project.imageAltText}
              />
            ) : (
              <Picture
                src={placeholderImg}
                alt="portfolio piece screenshot"
              />
            )}
          </div>
          <div class="content">
            <h3 class="project__title">{project.title}</h3>
            <p class="project__description">{project.description}</p>
            <a
              href={project.url}
              target="_blank"
              class="project__link"
              aria-label={project.imageAltText}
            >
              View Full Site
              <Icon
                name="icon-new-window"
                height={16}
                width={16}
              />
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .project__card {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow-sm);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    max-width: 360px;
    overflow: hidden;
    transition: all var(--transition);

    .project__link {
      align-items: center;
      color: var(--color-primary);
      display: flex;
      font-weight: 500;
      gap: 0.5rem;
      line-height: 0;
      margin-top: auto;
      position: relative;
      text-transform: uppercase;
      width: fit-content;

      &:hover {
        font-weight: 600;
        &::after {
          content: "";
          background-color: var(--color-primary);
          height: 2px;
          position: absolute;
          bottom: -4px;
          width: 100%;
        }
      }
    }

    .project__screenshot img {
      max-height: 12rem;
      width: 100%;
      object-fit: cover;
      object-position: top;
    }

    .content {
      padding: 1.5rem 2.3rem;
      display: flex;
      flex: 1;
      flex-direction: column;

      gap: var(--space-md);
    }
  }

  .card-container {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    justify-items: center;
    gap: 1rem;
  }
</style>
