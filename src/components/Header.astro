---
import ThemeToggle from "./ThemeToggle.astro";
---

<header>
  <div class="container">
    <nav>
      <ul class="nav__list">
        <li>
          <a href="#portfolio">Portfolio</a>
        </li>
        <li>
          <a href="#contact">Contact</a>
        </li>
      </ul>
    </nav>
    <ThemeToggle />
  </div>
</header>

<style>
  header {
    border-bottom: 1px solid var(--color-border);
    position: sticky;
    top: 0;
    .container {
      align-items: center;
      display: flex;
      gap: 2rem;
      justify-content: flex-end;
    }

    .nav__list {
      align-items: center;
      display: flex;
      gap: 1rem;
    }
  }
</style>
