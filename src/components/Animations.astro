<section>
  <div class="container">
    <button type="button" class="btn btn--card">
								<div class="btn-cart">
									<svg width="24" viewBox="0 0 24 24" id="cart" data-name="Flat Color" xmlns="http://www.w3.org/2000/svg" class="icon flat-color">
										<path id="secondary" d="M18.5,20.5A1.5,1.5,0,1,1,17,19,1.5,1.5,0,0,1,18.5,20.5ZM11,19a1.5,1.5,0,1,0,1.5,1.5A1.5,1.5,0,0,0,11,19Z"></path>
										<path id="primary" d="M21.79,6.38A1,1,0,0,0,21,6H7.48L7.12,3.69A2,2,0,0,0,5.14,2H3A1,1,0,0,0,3,4H5.14L7,16.15A1,1,0,0,0,8,17h.09l11-1a1,1,0,0,0,.88-.76l2-8A1,1,0,0,0,21.79,6.38Z"></path>
									</svg>
								</div>
								Add to Cart
							</button>
  </div>
</section>

<script>
	const addToCartBtns = document.querySelectorAll(".btn--card:has(.btn-cart)");

addToCartBtns.forEach((btn) => {
	btn.addEventListener("click", () => {
		btn.classList.add("active");
		setTimeout(() => {
			btn.classList.remove("active");
		}, 4000);
	});
});
</script>
<style>
	.btn--card {
		background-color: var(--color-primary);
		border: 1px solid var(--color-border);
		color: var(--color-text);
		margin-top: 1rem;
		overflow:hidden;
		padding: 0.5rem 1rem;
		position: relative;
		&:hover {
			background-color: var(--color-surface);
			color: var(--color-secondary);
			&::before {
				color: var(--color-text);
			}
		}

		&::before {
			content: "✓";
			font-size: 2rem;
			left: 50%;
			opacity: 0;
			position: absolute;
			top: 50%;
			transform: translate(-50%, -50%);
			z-index: 10;
		}

		&::after {
			content: "";
			background-color: var(--color-secondary);
			height: 100%;
			left: 0;
			position: absolute;
			top: 0;
			width: 0;
		}

		&.active {
			&::before {
				transition: opacity 0.5s linear 2s;
				opacity: 1;
			}
			&::after {
				transition: width 2s linear 0.3s;
				width: 100%;
			}

			.btn-cart {
				animation: cartLeftToRight 2s linear;
			}
		}
	}

.btn-cart {
		left: 0;
		position: absolute;
		transform: translateX(-100%);
		svg path {
			fill: var(--color-secondary);
		}
	}

.cart {
	svg {
		filter: drop-shadow(0px 0px 4px rgba(57, 255, 20, 0.8))
			drop-shadow(0px 0px 20px rgba(255, 0, 127, 0.6));
		transition: filter 0.3s ease, transform 0.3s ease;

		path {
			fill: var(--color-secondary);
		}

		&:hover {
			cursor: pointer;
			filter: drop-shadow(0px 0px 8px rgba(57, 255, 20, 1))
				drop-shadow(0px 0px 30px rgba(255, 0, 127, 0.8));
			transform: scale(1.05);
		}
	}
}

@keyframes cartLeftToRight {
	from {
		transform: translateX(-100%);
	}

	to {
		transform: translateX(620%); //24px * 6.2 = 148px (button is about 148px wide)
	}
}

</style>
