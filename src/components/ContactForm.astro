---
import { Icon } from "astro-icon/components";
---

<section id="contact">
  <div class="container">
    <h2>Contact Me</h2>
    <form
      id="contact-form"
      name="contact"
      method="POST"
      netlify-honeypot="bot-field"
      data-netlify="true"
    >
      <p class="hidden-form-field">
        <label>
          Don’t fill this out if you’re human:
          <input
            name="bot-field"
            type="text"
          />
        </label>
      </p>
      <input
        type="hidden"
        name="form-name"
        value="contact"
      />
      <div class="success-message">
        <div class="title">
          <Icon name="icon-success-check" />
          <h2>Message Sent!</h2>
        </div>
        <p>Thanks for completing the form. We'll be in touch soon!</p>
      </div>
      <div class="form-group">
        <label for="name">Name</label>
        <input
          type="text"
          id="name"
          name="name"
          oninvalid="this.setCustomValidity('This field is required')"
          oninput="this.setCustomValidity('')"
          required
        />
        <div class="error-message">This field is required</div>
      </div>

      <div class="form-group span-all">
        <label for="email">Email Address</label>
        <input
          type="email"
          id="email"
          name="email"
          oninvalid="this.setCustomValidity('Please enter a valid email address')"
          oninput="this.setCustomValidity('')"
          required
        />
        <div class="error-message">Please enter a valid email address</div>
      </div>

      <div class="form-group span-all">
        <label for="message">Message</label>
        <textarea
          name="message"
          id="message"
          oninvalid="this.setCustomValidity('This field is required')"
          oninput="this.setCustomValidity('')"
          required
        ></textarea>
        <div class="error-message">This field is required</div>
      </div>

      <button
        class="span-all btn btn--solid"
        type="submit"
      >
        Submit
      </button>
    </form>
  </div>
</section>

<script>
  const form = document.getElementById(
    "contact-form",
  ) as HTMLFormElement | null;
  const successMessage = document.querySelector(
    ".success-message",
  ) as HTMLElement | null;

  form?.addEventListener("submit", function (e: SubmitEvent) {
    e.preventDefault();

    const target = e.currentTarget;
    if (!(target instanceof HTMLFormElement)) return;

    const formData = new FormData(target);
    const searchParams = new URLSearchParams();

    for (const [key, value] of formData.entries()) {
      searchParams.append(
        key,
        value instanceof File ? value.name : value.toString(),
      );
    }

    fetch("/", {
      method: "POST",
      headers: { "Content-Type": "application/x-www-form-urlencoded" },
      body: searchParams.toString(),
    })
      .then(() => {
        console.log("Form successfully submitted");
        successMessage?.classList.add("visible");
        target.reset();
        setTimeout(() => successMessage?.classList.remove("visible"), 5000);
      })
      .catch((error) => alert(error));
  });
</script>

<style>
  h2 {
    margin-bottom: 1em;
  }

  /* General Form Styles */
  #contact-form {
    accent-color: var(--color-primary);
    position: relative;
    max-width: 45rem;
    margin-right: auto;
    background: var(--color-background);
    border-radius: var(--radius-sm);
    padding: clamp(1.5rem, 0.5458rem + 4.0712vw, 2.5rem);
    display: grid;
    grid-template-columns: 1fr;
  }

  .hidden-form-field {
    visibility: hidden;
    height: 0;
    position: absolute;
  }

  label {
    font: inherit;
    font-size: clamp(1rem, 0.895rem + 0.4479vw, 1.25rem);
    display: block;
    margin-bottom: 0.5rem;
  }

  button,
  input,
  textarea {
    font: inherit;
    width: 100%;
    cursor: pointer;
  }

  input:not([type="submit"]),
  textarea {
    background-color: var(--color-surface);
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-border);
    color: inherit;
    font-size: 1.125rem;
    padding: 0.66667em 1.33334em;
    height: 3rem;

    &:focus-visible {
      outline-color: var(--color-primary);
    }

    &:hover {
      border-color: var(--color-primary);
    }
  }

  textarea {
    min-height: calc(3lh + 1.4em); /* 3 line heights + vertical padding */
    resize: block;
  }

  .required::after {
    content: " *";
    color: var(--color-primary);
  }

  .form-group {
    margin-bottom: 1.5rem;
  }

  .form-group:has([required]) label {
    display: flex;
    gap: 1ch;

    &::after {
      content: "*";
      color: var(--color-primary);
    }
  }

  /* Error state */
  .error-message {
    padding-top: 0.25rem;
    color: var(--color-error);
    display: none;
    font-size: clamp(1rem, 0.895rem + 0.4479vw, 1.25rem);
  }

  .form-group:has(input:user-invalid),
  .form-group:has(textarea:user-invalid) {
    input,
    textarea {
      border-color: var(--color-error);
      outline: 1px solid var(--color-error);
    }

    .error-message {
      display: block;
    }
  }

  .span-all {
    grid-column: 1 / -1;
  }

  /* Success Message */
  .success-message {
    position: absolute;
    top: -1rem;
    left: 0;
    right: 0;
    margin: 0 auto;
    width: fit-content;
    background-color: var(--color-primary);
    border-radius: 0.75rem;
    color: var(--color-background);
    padding: 1.5rem;
    z-index: 2;
    display: none;

    &.visible {
      display: block;
    }

    .title {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      margin-bottom: 0.5rem;
      h2 {
        color: var(--color-background);
        font-size: 1.125rem;
      }
    }
  }

  @media (min-width: 48rem) {
    #contact-form {
      gap: 1.5rem 1rem;
    }

    .form-group {
      margin-bottom: 0;
    }
  }
</style>
